if ARCH_BOARD_IMXRT1180_EVK

config IMXRT1180_EVK_DTCM
	bool
	default y

config IMXRT1180_EVK_OCRAM_TEXT
	bool "Use split ITCM/OCRAM layout"
	default n
	---help---
		Place vectors and executable sections in ITCM, with read-only and
		writable sections in OCRAM.  This layout is intended for debugger-loaded
		images where CM33 can read and write OCRAM but OCRAM instruction fetches
		are blocked by the current ELE/TRDC debug handoff.

endif
